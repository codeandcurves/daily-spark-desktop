{
  "name": "daily-spark-desktop",
  "version": "1.5.0",
  "description": "A quiet Windows companion that resurfaces useful ideas, reminders and takeaways from your AI conversations.",
  "author": "codeandcurves",
  "license": "MIT",
  "main": "main.js",
  "scripts": {"start": "electron .", "dist": "electron-builder --win nsis"},
  "devDependencies": {"electron": "^39.0.0", "electron-builder": "^26.0.12"},
  "build": {
    "appId": "com.dailyspark.desktop",
    "productName": "Daily Spark",
    "artifactName": "Daily-Spark-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": {"target": "nsis"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true}
  }
}