{
  "name": "daily-spark-2",
  "version": "2.0.0",
  "description": "A private local desktop companion for useful takeaways from your AI conversations.",
  "author": "codeandcurves",
  "license": "MIT",
  "main": "main.js",
  "scripts": {"start": "electron .", "dist": "electron-builder --win nsis"},
  "dependencies": {"adm-zip": "^0.5.16"},
  "devDependencies": {"electron": "^39.0.0", "electron-builder": "^26.0.12"},
  "build": {
    "appId": "com.dailyspark.companion.v2",
    "productName": "Daily Spark 2",
    "artifactName": "Daily-Spark-2-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "app/**/*", "node_modules/adm-zip/**/*"],
    "win": {"target": "nsis"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true}
  }
}