{
  "name": "daily-spark-desktop",
  "version": "1.2.0",
  "description": "A compact Windows desktop companion for calm, randomized inspiration.",
  "author": "codeandcurves",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dailyspark.desktop",
    "productName": "Daily Spark",
    "files": ["main.js", "preload.js", "app/**/*", "assets/**/*"],
    "win": {"target": "nsis", "icon": "assets/tray.png"},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}